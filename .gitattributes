# Normalise line endings to LF in the repo (Windows checkouts convert as configured).
* text=auto eol=lf

*.php  text diff=php
*.css  text diff=css
*.js   text
*.json text
*.md   text diff=markdown
*.py   text diff=python

# Binary assets — never touch line endings or diff them.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary

# Keep repo-only files out of `git archive` theme zips.
.gitignore     export-ignore
.gitattributes export-ignore
demo/build-images.py export-ignore
